# Dependencies are installed inside the image - copying them from the host is
# often incompatible with the container architecture and needlessly inflates
# the build context.
node_modules
.next
out

# History and metadata
.git
.github
.gitignore

# Image sources (a dozen or so MB) - the repository already holds the
# optimized variants
.image-cache

# Local and temporary
.env
.env*.local
*.log
.DS_Store
Thumbs.db
.idea
.vscode

# Documentation does not affect the build result
README.md
LICENSE
